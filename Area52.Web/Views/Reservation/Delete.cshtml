@model BikeReservation

<h1>Delete reservation</h1>

<p>Are you sure you want to delete this reservation?</p>

<ul>
    <li><strong>Reservation Id:</strong> @Model.ReservationId</li>
    <li><strong>Bike:</strong> @ViewBag.BikeType (@Model.BikeId)</li>
    <li><strong>Start date:</strong> @Model.StartDate.ToShortDateString()</li>
    <li><strong>Days:</strong> @Model.Days</li>
    <li><strong>Total:</strong> €@Model.TotalPrice</li>
</ul>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.ReservationId" />
    <button type="submit">Yes, delete</button>
    <a asp-action="Index">Cancel</a>
</form>
