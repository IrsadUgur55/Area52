@*
    ============================================================================
    RESERVATION/CREATE.CSHTML - RESERVERING AANMAKEN
    ============================================================================
    
    Deze view toont het formulier voor het aanmaken van een nieuwe reservering.
    Elke fiets heeft zijn eigen inline formulier in de tabel.
    
    MODEL:
    IEnumerable<Bike> - Alle beschikbare fietsen waarvoor gereserveerd kan worden.
    
    FORMULIER FLOW:
    1. Gebruiker kiest een fiets uit de tabel
    2. Vult startdatum en aantal dagen in
    3. Selecteert optioneel verzekering en/of hulpdienst
    4. Klikt op "Reserveer Nu"
    5. Wordt doorgestuurd naar bevestigingspagina
    
    ANTI-FORGERY TOKEN:
    Elk formulier bevat een @Html.AntiForgeryToken() voor beveiliging
    tegen Cross-Site Request Forgery (CSRF) aanvallen.
    
    Auteur:    Frontend Team - Area52
    Versie:    1.0.0
    Cursus:    HBO ICT - Fontys Hogescholen
    ============================================================================
*@

@* 
    MODEL DIRECTIVE
    Ontvangt een collectie van fietsen van ReservationController.Create() GET action
*@
@model IEnumerable<Bike>

@* 
    ==========================================================================
    PAGE HEADER
    ==========================================================================
*@
<div class="page-header">
    <h1 data-translate="res.create.title">📅 Reservering Maken</h1>
</div>

@* 
    INSTRUCTIE KAART
    Geeft de gebruiker informatie over hoe het formulier werkt.
    .card-modern: Gestileerde kaart container
    .mb-4: Bootstrap margin-bottom
*@
<div class="card-modern mb-4">
    <p class="text-muted" style="margin-bottom: 0;" data-translate="res.create.subtitle">🚴 Kies een fiets en selecteer uw reserveringsgegevens hieronder.</p>
</div>

@* 
    ==========================================================================
    RESERVERINGENTABEL
    ==========================================================================
    
    Elke rij bevat:
    - Fiets informatie (ID, type, prijs)
    - Een inline formulier voor reserveringsgegevens
    
    Dit design patroon heet "inline editing" en is gebruiksvriendelijk
    omdat de gebruiker direct kan reserveren zonder naar een aparte pagina te gaan.
*@
<table class="table-modern">
    <thead>
        <tr>
            <th data-translate="res.create.table.id">ID</th>
            <th data-translate="res.create.table.type">Fietstype</th>
            <th data-translate="res.create.table.price">Dagprijs</th>
            <th data-translate="res.create.table.details">Reserveringsgegevens</th>
        </tr>
    </thead>
    <tbody>
    @* 
        FOREACH LOOP
        Itereert over alle beschikbare fietsen.
        Elk item krijgt een eigen reserveringsformulier.
    *@
    @foreach (var bike in Model)
    {
        <tr>
            @* FIETS ID als badge *@
            <td><span class="badge-modern badge-primary">#@bike.BikeId</span></td>
            
            @* 
                FIETS TYPE
                Conditionele weergave met emoji
            *@
            <td>
                @if (bike.Type == "ElectricBike")
                {
                    <span data-translate="bikes.type.electric">⚡ Elektrische Fiets</span>
                }
                else
                {
                    <span data-translate="bikes.type.city">🚲 Stadsfiets</span>
                }
            </td>
            
            @* DAGPRIJS met valuta symbool *@
            <td><strong>€@bike.DayPrice</strong><span data-translate="bikes.perday">/dag</span></td>
            
            @* 
                RESERVERINGSFORMULIER CEL
                Bevat het volledige inline formulier voor deze fiets.
            *@
            <td>
                @* 
                    FORMULIER ELEMENT
                    =================
                    
                    asp-action="Create": POST request naar ReservationController.Create()
                    method="post": HTTP POST methode (niet GET, want we wijzigen data)
                    
                    .reservation-form: Custom styling class
                *@
                <form asp-action="Create" method="post" class="reservation-form">
                @* 
                    ANTI-FORGERY TOKEN
                    ==================
                    
                    @Html.AntiForgeryToken() genereert een verborgen veld met een
                    unieke token die door de server wordt geverifieerd.
                    
                    Dit beschermt tegen CSRF aanvallen waarbij een kwaadaardige
                    website probeert een request te doen namens de gebruiker.
                    
                    De [ValidateAntiForgeryToken] attribute op de controller
                    valideert deze token bij POST requests.
                *@
                @Html.AntiForgeryToken()
                
                    @* 
                        HIDDEN INPUT VOOR BIKE ID
                        =========================
                        
                        Dit veld is niet zichtbaar voor de gebruiker maar wordt
                        wel meegestuurd met het formulier.
                        
                        name="bikeId": De parameter naam die de controller verwacht
                        value="@bike.BikeId": De waarde van de huidige fiets
                        
                        Zonder dit veld zou de server niet weten welke fiets
                        gereserveerd moet worden.
                    *@
                    <input type="hidden" name="bikeId" value="@bike.BikeId" />

                    @* 
                        FLEXBOX CONTAINER VOOR FORMULIER ELEMENTEN
                        ==========================================
                        
                        Inline styling voor layout:
                        - display: flex - Elementen naast elkaar
                        - gap: 16px - Ruimte tussen elementen
                        - align-items: center - Verticaal gecentreerd
                        - flex-wrap: wrap - Wrap naar nieuwe regel op smalle schermen
                    *@
                    <div style="display:flex; gap:16px; align-items:center; flex-wrap:wrap;">
                        
                        @* 
                            STARTDATUM VELD
                            ===============
                            
                            .form-group-inline: Container met label boven input
                            type="date": HTML5 date picker
                            required: HTML5 validatie - veld is verplicht
                            .form-control-sm: Bootstrap small form control
                        *@
                        <div class="form-group-inline">
                            <label class="form-label-sm" data-translate="res.create.startdate">Startdatum</label>
                            <input type="date" name="startDate" required class="form-control form-control-sm" />
                        </div>

                        @* 
                            AANTAL DAGEN VELD
                            =================
                            
                            type="number": Numeriek input veld met +/- knoppen
                            value="1": Standaardwaarde
                            min="1": Minimum waarde (moet minstens 1 dag zijn)
                            style="width:80px": Beperkte breedte voor compact design
                        *@
                        <div class="form-group-inline">
                            <label class="form-label-sm" data-translate="res.create.days">Dagen</label>
                            <input type="number" name="days" value="1" min="1" required class="form-control form-control-sm" style="width:80px;" />
                        </div>

                        @* 
                            VERZEKERING OPTIE (CHECKBOX)
                            ============================
                            
                            .form-check-inline: Bootstrap inline checkbox styling
                            
                            CHECKBOX INPUT:
                            - type="checkbox": Aan/uit schakelaar
                            - name="optionKeys": Parameter naam voor array van opties
                            - value: RentalOptionKeys.DamageInsurance enum waarde
                            
                            De naam "optionKeys" met dezelfde naam op meerdere checkboxes
                            zorgt ervoor dat alle aangevinkte waarden als array worden
                            verstuurd naar de controller.
                        *@
                        <div class="form-check-inline">
                            <label class="form-check-label">
                                <input type="checkbox" name="optionKeys" value="@Area52.Domain.Options.RentalOptionKeys.DamageInsurance" class="form-check-input" />
                                <span data-translate="res.create.insurance">🛡️ Verzekering (+2%)</span>
                            </label>
                        </div>

                        @* 
                            HULPDIENST OPTIE (CHECKBOX)
                            ===========================
                            
                            Tweede optie voor pechhulp service.
                            Gebruikt dezelfde name="optionKeys" voor array binding.
                        *@
                        <div class="form-check-inline">
                            <label class="form-check-label">
                                <input type="checkbox" name="optionKeys" value="@Area52.Domain.Options.RentalOptionKeys.Assistance" class="form-check-input" />
                                <span data-translate="res.create.assistance">📞 Hulpdienst (+€5)</span>
                            </label>
                        </div>

                        @* 
                            SUBMIT BUTTON
                            =============
                            
                            type="submit": Verstuurt het formulier naar de server
                            .btn-success: Groene kleur voor positieve actie
                            .btn-sm: Small button variant
                        *@
                        <button type="submit" class="btn btn-success btn-sm" data-translate="res.create.submit">Reserveer Nu</button>
                    </div>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

@* 
    TERUG NAVIGATIE
    ===============
    
    Link terug naar het fietsen overzicht.
    Geeft de gebruiker een duidelijke uitweg als ze toch niet willen reserveren.
*@
<div style="margin-top: 24px;">
    <a class="btn btn-secondary" asp-action="Index" asp-controller="Bike" data-translate="res.create.back">← Terug naar Fietsen</a>
</div>
