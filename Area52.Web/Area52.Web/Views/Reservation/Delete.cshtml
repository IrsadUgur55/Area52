@model BikeReservation

<div class="page-header">
    <h1 data-translate="res.delete.title">⚠️ Reservering Annuleren</h1>
</div>

<div class="card-modern" style="max-width: 500px; border-left: 4px solid #dc3545;">
    <div style="background: rgba(220, 53, 69, 0.1); padding: 16px; border-radius: 8px; margin-bottom: 20px;">
        <p style="margin: 0; color: #dc3545; font-weight: 500;" data-translate="res.delete.confirm">⚠️ Weet u zeker dat u deze reservering wilt verwijderen?</p>
    </div>

    <div style="display: grid; gap: 12px;">
        <div>
            <p class="text-muted mb-1" data-translate="confirm.resid">Reserverings-ID</p>
            <p><span class="badge-modern badge-primary">#@Model.ReservationId</span></p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="confirm.bike">Fiets</p>
            <p>
                @if (ViewBag.BikeType == "ElectricBike")
                {
                    <span data-translate="bikes.type.electric">⚡ Elektrische Fiets</span>
                }
                else
                {
                    <span data-translate="bikes.type.city">🚲 Stadsfiets</span>
                }
                <small class="text-muted">(#@Model.BikeId)</small>
            </p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="confirm.start">Startdatum</p>
            <p><strong>@Model.StartDate.ToShortDateString()</strong></p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="confirm.duration">Duur</p>
            <p><span class="badge-modern badge-success">@Model.Days <span data-translate="res.days">dagen</span></span></p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="confirm.total">Totaalprijs</p>
            <p><strong style="color: var(--accent-green); font-size: 1.3rem;">€@Model.TotalPrice</strong></p>
        </div>
    </div>

    <form asp-action="Delete" method="post" style="margin-top: 24px;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.ReservationId" />
        <div style="display: flex; gap: 12px;">
            <button type="submit" class="btn btn-danger" data-translate="res.delete.yes">🗑️ Ja, Verwijderen</button>
            <a asp-action="Index" class="btn btn-secondary" data-translate="res.delete.no">← Nee, Terug</a>
        </div>
    </form>
</div>
