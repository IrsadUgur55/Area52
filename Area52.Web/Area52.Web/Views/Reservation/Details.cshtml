@model BikeReservation

<div class="page-header">
    <h1 data-translate="res.details.title">📋 Reserveringsdetails</h1>
</div>

<div class="card-modern" style="max-width: 600px;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div>
            <p class="text-muted mb-1" data-translate="confirm.resid">Reserverings-ID</p>
            <p><span class="badge-modern badge-primary">#@Model.ReservationId</span></p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="confirm.bike">Fiets</p>
            <p>
                @if (ViewBag.BikeType == "ElectricBike")
                {
                    <span data-translate="bikes.type.electric">⚡ Elektrische Fiets</span>
                }
                else
                {
                    <span data-translate="bikes.type.city">🚲 Stadsfiets</span>
                }
                <small class="text-muted">(#@Model.BikeId)</small>
            </p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="res.details.dayprice">Dagprijs</p>
            <p><strong>€@ViewBag.DayPrice</strong><span data-translate="bikes.perday">/dag</span></p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="confirm.start">Startdatum</p>
            <p><strong>@Model.StartDate.ToShortDateString()</strong></p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="confirm.duration">Duur</p>
            <p><span class="badge-modern badge-success">@Model.Days <span data-translate="res.days">dagen</span></span></p>
        </div>
    </div>

    <hr style="margin: 24px 0; border-color: var(--cream-dark);" />

    @if (Model.Options != null && Model.Options.Any())
    {
        <h5 style="margin-bottom: 12px;" data-translate="confirm.options">🛠️ Geselecteerde Opties</h5>
        <ul style="list-style: none; padding: 0;">
            @foreach (var opt in Model.Options)
            {
                <li style="padding: 8px 0;"><span class="badge-modern badge-primary">@opt.Name</span></li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted"><em data-translate="confirm.nooptions">Geen extra opties geselecteerd.</em></p>
    }

    <div style="background: linear-gradient(135deg, var(--accent-green-light) 0%, var(--accent-green) 100%); color: white; padding: 20px; border-radius: 10px; margin-top: 24px; text-align: center;">
        <p style="margin: 0; font-size: 0.9rem; opacity: 0.9;" data-translate="confirm.total">Totaalprijs</p>
        <p style="margin: 0; font-size: 2rem; font-weight: 700;">€@Model.TotalPrice</p>
    </div>

    <div style="display: flex; gap: 12px; margin-top: 24px;">
        <a class="btn btn-success" asp-action="Create" data-translate="res.btn.new">+ Nieuwe Reservering</a>
        <a class="btn btn-secondary" asp-action="Index" data-translate="res.details.back">← Terug naar Overzicht</a>
        <a class="btn btn-danger" asp-action="Delete" asp-route-id="@Model.ReservationId" data-translate="res.details.cancel">❌ Annuleren</a>
    </div>
</div>
