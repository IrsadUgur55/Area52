@model Bike

<div class="page-header">
    <h1 data-translate="bikes.details.title">🚲 Fietsdetails</h1>
</div>

<div class="card-modern" style="max-width: 500px;">
    <div style="display: grid; gap: 16px;">
        <div>
            <p class="text-muted mb-1" data-translate="bikes.table.id">ID</p>
            <p><span class="badge-modern badge-primary">#@Model.BikeId</span></p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="bikes.table.type">Type</p>
            <p>
                @if (Model.Type == "ElectricBike")
                {
                    <span data-translate="bikes.type.electric">⚡ Elektrische Fiets</span>
                }
                else
                {
                    <span data-translate="bikes.type.city">🚲 Stadsfiets</span>
                }
            </p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="bikes.table.price">Dagprijs</p>
            <p><strong style="color: var(--accent-green); font-size: 1.5rem;">€@Model.DayPrice</strong><span data-translate="bikes.perday">/dag</span></p>
        </div>
        <div>
            <p class="text-muted mb-1" data-translate="bikes.table.date">Aankoopdatum</p>
            <p><strong>@Model.PurchaseDate.ToShortDateString()</strong></p>
        </div>
    </div>

    <div style="display: flex; gap: 12px; margin-top: 24px;">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.BikeId" data-translate="bikes.action.edit">✏️ Bewerken</a>
        <a class="btn btn-success" asp-controller="Reservation" asp-action="Create" data-translate="bikes.btn.reserve">📅 Reserveren</a>
        <a class="btn btn-secondary" asp-action="Index" data-translate="bikes.details.back">← Terug</a>
    </div>
</div>
